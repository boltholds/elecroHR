# Copy to .env; never commit secrets. Offline demo works without credentials.
API_TOKEN=
LIVE_ENABLED=false
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-6-luna
SCORING_MODEL=gpt-6-luna
LIVE_VOICE=marin

# Obtain a SIP trunk with TLS + SDES-SRTP and outbound PSTN routing.
SIP_PROVIDER_URL=sips:your-provider.example:5061
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=
ALLOWED_TEST_NUMBER=
REQUIRE_CONSENT=true

CALL_TIMEOUT_SECONDS=900
RING_TIMEOUT_SECONDS=180
CLOSE_TIMEOUT_SECONDS=10
FAREWELL_SECONDS=5
HTTP_TIMEOUT_SECONDS=30
SCORING_TIMEOUT_SECONDS=90
# Optional absolute paths, ideally a volume with sufficient free space:
# DATA_DIR=D:/hr-caller-data
# KNOWLEDGE_DIR=C:/path/to/knowledge
# RUBRIC_PATH=C:/path/to/scoring_rubric.json
