# Copy this file to .env for Docker Compose configuration.
LOCAL_LLM_MODEL=qwen3:4b
# Optional: Hugging Face personal read-only token. Never commit your real token.
HF_TOKEN=
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=45
# Try 1 only if Xet transfer fails on your connection.
HF_HUB_DISABLE_XET=0

# XTTS-v2: preset voice from the bundled speaker list.
XTTS_SPEAKER=Asya Anara
# Optional: ./voices/reference.wav, recorded with the speaker's consent.
# When set, a voice reference overrides the preset voice.
XTTS_SPEAKER_WAV=
# XTTS-v2 checkpoint and generated audio: Coqui Public Model License.
# Non-commercial use and certain evaluation/research only.
